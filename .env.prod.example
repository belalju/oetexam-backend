# Copy this file to .env and fill in real values — never commit the actual .env file.
#   - Server: docker compose loads .env into the app container (env_file)
#   - Local dev: Spring Boot reads .env from the working directory (spring.config.import)

DB_USERNAME=oetuser
DB_PASSWORD=change_me_strong_password

# Optional — defaults to the host MySQL via host.docker.internal:3308 in Docker,
# and to the dev datasource URL when running locally
#DB_URL=jdbc:mysql://host.docker.internal:3308/oet_practice?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Generate with: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-key-change-in-production-must-be-at-least-64-chars-long

# Token expiry in milliseconds (defaults: 1h / 7d)
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=https://oetpractice.org,https://www.oetpractice.org

# Google Sign-In — OAuth 2.0 Web client ID (same one used by the Angular frontend)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# SMTP for verification emails (Gmail: use an App Password, not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user@gmail.com
SMTP_PASSWORD=your-smtp-app-password
MAIL_FROM=no-reply@oetpractice.com

# Frontend base URL used in verification email links
FRONTEND_BASE_URL=https://oetpractice.org

# Public HTTPS URL of this backend (REQUIRED — no default; no trailing slash).
# SSLCommerz callbacks and IPN URLs are built from it, so it must be reachable from the internet.
BACKEND_BASE_URL=https://oetpractice.org

# --- SSLCommerz payment gateway (all three REQUIRED — startup fails if missing) ---
# Testing server: sandbox URL + sandbox store credentials
# Live server:    https://securepay.sslcommerz.com + live store credentials
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password

# Optional overrides — leave commented to use the defaults shown.
# Browser callbacks (default: ${BACKEND_BASE_URL}/api/payments/callback/{success,fail,cancel})
#SSLCOMMERZ_SUCCESS_URL=https://oetpractice.org/api/payments/callback/success
#SSLCOMMERZ_FAIL_URL=https://oetpractice.org/api/payments/callback/fail
#SSLCOMMERZ_CANCEL_URL=https://oetpractice.org/api/payments/callback/cancel
# Frontend page the callbacks redirect to (default: ${FRONTEND_BASE_URL}/payment → /payment/{success,fail,cancel})
#SSLCOMMERZ_RESULT_PAGE_URL=https://oetpractice.org/payment
# IPN listener (default: ${BACKEND_BASE_URL}/api/payments/ipn) — also set this URL in the SSLCommerz merchant panel
#SSLCOMMERZ_IPN_URL=https://oetpractice.org/api/payments/ipn
